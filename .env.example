LLM_PROVIDER = "openai" # anthropic, openai, google_vertex_ai, google_genai
LLM_MODEL = "gpt-4o-mini"

# API Keys
OPENAI_API_KEY = your_openai_api_key_here
ANTHROPIC_API_KEY = your_anthropic_api_key_here
GEMINI_API_KEY = your_google_genai_api_key_here
GOOGLE_CLOUD_PROJECT = your_google_cloud_project_id_here

# LangSmith Tracing
LANGCHAIN_TRACING_V2 = true/false
LANGCHAIN_API_KEY = your_langchain_api_key_here
LANGCHAIN_PROJECT = your_langchain_project_name_here

# Aliases
LANGSMITH_API_KEY = your_langsmith_api_key_here
LANGSMITH_PROJECT = your_langsmith_project_name_here