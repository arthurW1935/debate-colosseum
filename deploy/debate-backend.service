[Unit]
Description=Debate Colosseum FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/debate-colosseum
EnvironmentFile=/home/ubuntu/debate-colosseum/.env
ExecStart=/home/ubuntu/debate-colosseum/.venv/bin/uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
